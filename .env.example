# ==============================================
# MANHAJI ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ==============================================
# AI/LLM CONFIGURATION
# ==============================================

# Gemini API Key (Google AI Studio)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative LLM Providers (optional - uncomment if using)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# LLM Model Selection
LLM_MODEL=gemini-1.5-pro
# Options: gemini-1.5-pro, gemini-1.5-flash, gpt-4, claude-3-opus

# ==============================================
# BACKEND API CONFIGURATION
# ==============================================

# Backend API Base URL
BACKEND_URL=http://localhost:8000
# Production: https://api.manhaji.com

# Frontend Base URL
FRONTEND_URL=http://localhost:3001
# Production: https://app.manhaji.com

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@localhost:5432/manhaji_db
# Format: postgresql://[user]:[password]@[host]:[port]/[database]

# Redis Connection (for caching and task queue)
REDIS_URL=redis://localhost:6379/0
# Format: redis://[host]:[port]/[db]

# ==============================================
# VECTOR DATABASE (RAG)
# ==============================================

# Pinecone Configuration (for curriculum embeddings)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=manhaji-curriculum

# Alternative: Qdrant (self-hosted vector DB)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_key_here

# Alternative: pgvector (PostgreSQL extension - uses DATABASE_URL)
# VECTOR_STORE=pgvector

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Expiration (in seconds)
JWT_EXPIRATION=86400
# 86400 = 24 hours, 604800 = 7 days

# Bcrypt Salt Rounds (10-12 recommended)
BCRYPT_ROUNDS=10

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
# Production: https://app.manhaji.com,https://www.manhaji.com

# ==============================================
# FILE STORAGE
# ==============================================

# Object Storage Provider (s3, huawei, local)
STORAGE_PROVIDER=local

# AWS S3 Configuration (if using S3)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=manhaji-uploads
# AWS_REGION=us-east-1

# Huawei Cloud OBS Configuration (if using Huawei Cloud)
# HUAWEI_ACCESS_KEY=your_huawei_access_key
# HUAWEI_SECRET_KEY=your_huawei_secret_key
# HUAWEI_BUCKET=manhaji-uploads
# HUAWEI_REGION=cn-north-1

# Local Storage Path (if using local storage)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
# 10485760 bytes = 10 MB

# ==============================================
# EMAIL CONFIGURATION (for notifications)
# ==============================================

# SMTP Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@manhaji.com

# ==============================================
# PAYMENT GATEWAY (B2C Subscriptions)
# ==============================================

# Stripe Configuration
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Alternative: Egyptian Payment Gateway (Fawry, Paymob, etc.)
# PAYMOB_API_KEY=your_paymob_api_key
# PAYMOB_INTEGRATION_ID=your_integration_id

# ==============================================
# ANALYTICS & MONITORING
# ==============================================

# Google Analytics (optional)
# GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry (error tracking - optional)
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ==============================================
# DEVELOPMENT & DEBUGGING
# ==============================================

# Environment Mode
NODE_ENV=development
# Options: development, production, test

# Debug Logging
DEBUG=true
LOG_LEVEL=info
# Options: error, warn, info, debug

# Enable Dev Bypass (allows "🛠 Dev Access" button)
ENABLE_DEV_BYPASS=true
# Set to false in production!

# ==============================================
# AI BEHAVIOR TUNING
# ==============================================

# LLM Temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7
# Recommendation: 0.5-0.7 for educational content

# Max Tokens per Response
LLM_MAX_TOKENS=2048

# RAG Context Window (number of retrieved chunks)
RAG_TOP_K=5
# How many curriculum chunks to retrieve per query

# Misconception Detection Threshold
MISCONCEPTION_CONFIDENCE_THRESHOLD=0.75
# 0.0 to 1.0 (higher = fewer false positives)

# ==============================================
# RATE LIMITING
# ==============================================

# API Rate Limits (requests per minute per user)
RATE_LIMIT_FREE_TIER=10
RATE_LIMIT_PREMIUM_TIER=100
RATE_LIMIT_ADMIN=1000

# ==============================================
# CURRICULUM & CONTENT
# ==============================================

# Default Curriculum Authority
CURRICULUM_AUTHORITY=MOETE
# Options: MOETE (Egyptian), IB, IGCSE, American (future)

# Supported Grades
SUPPORTED_GRADES=7,8,9,10

# Supported Subjects
SUPPORTED_SUBJECTS=Mathematics,Physics,Chemistry

# Academic Year
ACADEMIC_YEAR=2024-2025

# ==============================================
# FEATURE FLAGS
# ==============================================

# Enable specific features
FEATURE_VOICE_INTERACTION=false
FEATURE_3D_VISUALS=false
FEATURE_TEACHER_DASHBOARD=false
FEATURE_SCHOOL_ANALYTICS=false

# ==============================================
# NOTES
# ==============================================
# 
# REQUIRED FOR MVP:
# - GEMINI_API_KEY (or other LLM key)
# - DATABASE_URL
# - JWT_SECRET
# - BACKEND_URL
# - FRONTEND_URL
#
# OPTIONAL FOR MVP:
# - PINECONE_API_KEY (can use local vector storage initially)
# - STRIPE_SECRET_KEY (if payment integration needed)
# - SMTP configuration (if email notifications needed)
#
# PRODUCTION CHECKLIST:
# 1. Change all secrets (JWT_SECRET, database passwords)
# 2. Set NODE_ENV=production
# 3. Set ENABLE_DEV_BYPASS=false
# 4. Configure proper CORS_ORIGINS
# 5. Set up proper cloud storage (not local)
# 6. Enable error tracking (Sentry)
# 7. Configure production database with backups
